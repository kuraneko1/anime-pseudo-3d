{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anime Pseudo-3D Motion Pack Schema (v1.0)",
  "description": "Character-agnostic declarative scene & motion specification consumed by engine/anime_stack_engine.js and engine/bundle_standalone.py.",
  "type": "object",
  "required": ["schema_version", "title", "character", "motions", "assets"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "badge_icon": { "type": "string" },
    "defaults": {
      "type": "object",
      "properties": {
        "motion": { "type": "string" },
        "animFps": { "type": "integer", "default": 24 },
        "renderMode": { "type": "integer", "enum": [0, 1, 2, 3], "default": 2 },
        "dotSize": { "type": "number", "default": 1.35 },
        "squash": { "type": "number", "default": 0.35 },
        "spacing": { "type": "number", "default": 1.0 },
        "zoom": { "type": "number", "default": 1.45 },
        "themeIdx": { "type": "integer", "enum": [0, 1, 2], "default": 1 },
        "angleDeg": { "type": "number", "default": 20.0 }
      }
    },
    "character": {
      "type": "object",
      "required": ["sliceW", "sliceH", "sliceCount", "atlasCols", "atlasRows"],
      "properties": {
        "sliceW": { "type": "integer" },
        "sliceH": { "type": "integer" },
        "sliceCount": { "type": "integer" },
        "atlasCols": { "type": "integer" },
        "atlasRows": { "type": "integer" },
        "yOffset": { "type": "number", "default": 0.0 },
        "fboVirtW": { "type": "integer", "default": 196 },
        "fboVirtH": { "type": "integer", "default": 440 },
        "fboPivotYOffset": { "type": "number", "default": 92 },
        "faceFocusZ": { "type": "number", "default": 104.0 }
      }
    },
    "companions": {
      "type": "object",
      "description": "Reusable 3D sprite-stacked companion definitions keyed by companion ID.",
      "additionalProperties": {
        "type": "object",
        "required": ["sliceW", "sliceH", "sliceCount", "atlasCols", "atlasRows", "keyPrefix"],
        "properties": {
          "sliceW": { "type": "integer" },
          "sliceH": { "type": "integer" },
          "sliceCount": { "type": "integer" },
          "atlasCols": { "type": "integer" },
          "atlasRows": { "type": "integer" },
          "frames": { "type": "integer", "default": 24 },
          "keyPrefix": { "type": "string" },
          "fboVirtW": { "type": "integer", "default": 96 },
          "fboVirtH": { "type": "integer", "default": 132 },
          "scale": { "type": "number", "default": 0.92 },
          "outlineRgb": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
        }
      }
    },
    "motions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "keyPrefix"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "subtitle": { "type": "string" },
          "accent": { "type": "string", "enum": ["default", "ceo", "companion", "attack"] },
          "icon": { "type": "string" },
          "frames": { "type": "integer", "default": 24 },
          "keyPrefix": { "type": "string" },
          "impulse": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "airFrames": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
          "springBeats": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["frame", "sx", "sy"],
              "properties": {
                "frame": { "type": "integer" },
                "sx": { "type": "number" },
                "sy": { "type": "number" }
              }
            }
          },
          "companion": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "rx": { "type": "number" },
              "ry": { "type": "number" },
              "zBase": { "type": "number" },
              "zSin1": { "type": "number" },
              "zSin2": { "type": "number" },
              "faceTangent": { "type": "boolean", "default": true }
            }
          },
          "billboard": {
            "type": "object",
            "properties": {
              "assetKey": { "type": "string" },
              "width": { "type": "number" },
              "height": { "type": "number" },
              "anchorZ": { "type": "number", "default": 128 },
              "offsetX": { "type": "number", "default": -64 },
              "offsetY": { "type": "number", "default": -30 },
              "bobAmp": { "type": "number", "default": 3.8 }
            }
          },
          "fx": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "sparkle_perimeter",
                    "orbit_trail",
                    "burst_above",
                    "forward_slash_fan",
                    "helix_vortex",
                    "floor_wave_rings"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "description": "Map of assetKey -> { file: relativePath, linear?: boolean }",
      "additionalProperties": {
        "type": "object",
        "required": ["file"],
        "properties": {
          "file": { "type": "string" },
          "linear": { "type": "boolean", "default": false }
        }
      }
    }
  }
}
